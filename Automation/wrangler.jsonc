{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitstride-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitstride-automation",
      "database_id": "f01dfae0-9218-4b5e-b3b4-194e576b5f40",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTOMATION_EVENTS",
        "class_name": "AutomationEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AutomationEvents"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUTOMATION_QUEUE",
        "queue": "gitstride-automation"
      }
    ],
    "consumers": [
      {
        "queue": "gitstride-automation",
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        "max_retries": 8,
        "dead_letter_queue": "gitstride-automation-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "gitstride-automation-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  },
  "vars": {
    "GITHUB_API_VERSION": "2026-03-10"
  },
  "secrets": {
    "required": [
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "GITHUB_OAUTH_CLIENT_ID",
      "GITHUB_OAUTH_CLIENT_SECRET",
      "GITHUB_APP_SLUG",
      "GITHUB_WEBHOOK_SECRET",
      "OAUTH_TOKEN_ENCRYPTION_KEY",
      "PUBLIC_BASE_URL"
    ]
  }
}
