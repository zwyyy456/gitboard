{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitboard-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitboard-automation",
      "database_id": "4aacb44d-f927-4018-9738-9214c7539004",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AUTOMATION_QUEUE",
        "queue": "gitboard-automation"
      }
    ],
    "consumers": [
      {
        "queue": "gitboard-automation",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "gitboard-automation-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "gitboard-automation-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  },
  "vars": {
    "GITHUB_API_VERSION": "2026-03-10"
  },
  "secrets": {
    "required": [
      "GITHUB_APP_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "GITHUB_OAUTH_CLIENT_ID",
      "GITHUB_OAUTH_CLIENT_SECRET",
      "GITHUB_APP_SLUG",
      "GITHUB_WEBHOOK_SECRET",
      "OAUTH_TOKEN_ENCRYPTION_KEY",
      "PUBLIC_BASE_URL"
    ]
  }
}
