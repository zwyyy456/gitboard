{
  "name": "gitboard-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "config:check": "node --env-file-if-exists=.dev.vars.production scripts/check-release-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "release:check": "npm run typecheck && npm test && npm run test:integration && npm run build && npm run config:check",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "engines": {
    "node": ">=22"
  }
}
